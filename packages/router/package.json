{
  "name": "@asterflow/router",
  "version": "2.1.0",
  "description": "Typed route and middleware definitions (Method, Router, Middleware) for AsterFlow applications.",
  "keywords": [
    "asterflow",
    "router",
    "routing",
    "middleware",
    "http",
    "typescript"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/mjs/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "Ashu11-A",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsterFlow/AsterFlow.git"
  },
  "bugs": {
    "url": "https://github.com/AsterFlow/AsterFlow/issues"
  },
  "homepage": "https://github.com/AsterFlow/AsterFlow",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@asterflow/request": "workspace:../request",
    "@asterflow/response": "workspace:../response",
    "@asterflow/url-parser": "^4.1.1",
    "asterflow": "workspace:../../core"
  },
  "peerDependencies": {
    "@caeljs/tsh": "^1.1.3",
    "zod": "^3.25.67",
    "typescript": "^5.8.3"
  }
}
