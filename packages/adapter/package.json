{
  "name": "@asterflow/adapter",
  "version": "2.0.0",
  "description": "Wires a runtime's native server (Bun.serve, Node's http, Express, Fastify) into AsterFlow, converting native requests to Request and sending back AsterResponse the same way regardless of runtime.",
  "keywords": [
    "asterflow",
    "adapter",
    "http",
    "bun",
    "node",
    "express",
    "fastify"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/mjs/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "Ashu11-A",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsterFlow/AsterFlow.git"
  },
  "bugs": {
    "url": "https://github.com/AsterFlow/AsterFlow/issues"
  },
  "homepage": "https://github.com/AsterFlow/AsterFlow",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@asterflow/router": "workspace:../router"
  },
  "peerDependencies": {
    "fastify": "^5.12.1",
    "express": "^5.1.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@asterflow/response": "workspace:../response",
    "@asterflow/request": "workspace:../request"
  }
}
