{
  "name": "@asterflow/request",
  "version": "1.0.13",
  "description": "Wraps the native request object of Bun, Node, Express, or Fastify into one typed AsterRequest, so the rest of AsterFlow reads requests the same way regardless of runtime.",
  "keywords": ["asterflow", "request", "http"],
  "main": "dist/cjs/index.cjs",
  "module": "dist/mjs/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@asterflow/router": "workspace:../router",
    "@asterflow/url-parser": "^4.1.1"
  },
  "devDependencies": {
    "@asterflow/adapter": "workspace:../adapter",
    "@types/express": "^5.0.6",
    "fastify": "^5.12.1",
    "undici-types": "^7.29.0"
  }
}
