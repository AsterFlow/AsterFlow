{
  "name": "asterflow",
  "version": "2.0.0",
  "description": "The core framework - ties together adapters, routing, plugins and responses into one typed AsterFlow app.",
  "keywords": [
    "asterflow",
    "http",
    "framework",
    "server",
    "router",
    "typescript"
  ],
  "main": "dist/cjs/index.cjs",
  "module": "dist/mjs/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "type": "module",
  "license": "MIT",
  "author": "Ashu11-A",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsterFlow/AsterFlow.git"
  },
  "bugs": {
    "url": "https://github.com/AsterFlow/AsterFlow/issues"
  },
  "homepage": "https://github.com/AsterFlow/AsterFlow",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --inspect=ws://localhost:6499 src/index.ts"
  },
  "peerDependencies": {
    "zod": "^3.25.67",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@asterflow/adapter": "workspace:../packages/adapter",
    "@asterflow/plugin": "workspace:../packages/plugin",
    "@asterflow/response": "workspace:../packages/response",
    "@asterflow/router": "workspace:../packages/router",
    "@asterflow/url-parser": "^4.1.1",
    "reminist": "^1.0.8"
  }
}
