{
  "compilerOptions": {
    /* Environment setup & latest features */
    "lib": ["esnext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Required by TypeORM's `@Entity()`/`@Column()` decorators (example/src/entities)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "baseUrl": ".",
    "paths": {
      "asterflow": ["core/src/index.ts"],
      "@asterflow/adapter": ["packages/adapter/src/index.ts"],
      "@asterflow/request": ["packages/request/src/index.ts"],
      "@asterflow/response": ["packages/response/src/index.ts"],
      "@asterflow/router": ["packages/router/src/index.ts"],
      "@asterflow/plugin": ["packages/plugin/src/index.ts"],
      "@asterflow/fs": ["plugins/fs/src/index.ts"],
      "@asterflow/multipart": ["plugins/multipart/src/index.ts"],
      "@asterflow/*": ["packages/*/src/index.ts", "plugins/*/src/index.ts"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
  }
}
